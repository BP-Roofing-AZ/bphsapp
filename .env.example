# Blueprint Home Services CRM — environment template.
# Copy to .env (for wrangler-local dev use .dev.vars instead) and
# replace every REPLACE_ME value with a real credential from the
# account owner. All of these are required for the app to run
# end-to-end; missing any one causes the corresponding feature to
# fail closed at runtime.

# ── Core ──────────────────────────────────────────────────
NODE_ENV=production
APP_BASE_URL=https://app.blueprinthomeservice.com
OUTBOUND_FROM_ADDRESS=office@blueprinthomeservice.com

# ── Auth ──────────────────────────────────────────────────
AUTH_JWT_SECRET=REPLACE_ME
SESSION_SECRET=REPLACE_ME

# ── Cloudflare (D1 + R2 configured as bindings, not env) ──
# See wrangler.toml for DB + FILES bindings.

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
SUPPORT_INBOX=REPLACE_ME@example.com
SUPPORT_NOTIFY_EMAILS=REPLACE_ME@example.com
SUPPORT_FALLBACK_INBOX=REPLACE_ME@example.com
INBOUND_FALLBACK_INBOX=REPLACE_ME@example.com

# ── SMS (Twilio) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACREPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=+15555555555
TWILIO_MESSAGING_SERVICE_SID=MGREPLACE_ME

# ── Payments (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── OAuth (Google) ────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://app.blueprinthomeservice.com/auth/google/callback

# ── OAuth (Microsoft) ─────────────────────────────────────
MS_CLIENT_ID=REPLACE_ME
MS_CLIENT_SECRET=REPLACE_ME
MS_TENANT_ID=REPLACE_ME
MS_REDIRECT_URI=https://app.blueprinthomeservice.com/auth/microsoft/callback

# ── DocuSign (legacy signing) ─────────────────────────────
DOCUSIGN_INTEGRATION_KEY=REPLACE_ME
DOCUSIGN_USER_ID=REPLACE_ME
DOCUSIGN_ACCOUNT_ID=REPLACE_ME
DOCUSIGN_RSA_KEY_B64=REPLACE_ME_BASE64_ENCODED

# ── EagleView ─────────────────────────────────────────────
EAGLEVIEW_API_KEY=REPLACE_ME
EAGLEVIEW_CLIENT_ID=REPLACE_ME

# ── JobNimbus (legacy sync) ───────────────────────────────
JOBNIMBUS_API_KEY=REPLACE_ME
AUTO_SYNC_SECRET=REPLACE_ME

# ── ABC Supply ────────────────────────────────────────────
ABC_CLIENT_ID=REPLACE_ME
ABC_CLIENT_SECRET=REPLACE_ME

# ── Web Push (VAPID) ──────────────────────────────────────
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:REPLACE_ME@example.com

# ── Feature flags ─────────────────────────────────────────
ENABLE_JOBNIMBUS_SYNC=0
ENABLE_STRIPE_SURCHARGE=1
ENABLE_DOCUSIGN=0

